{
  "name": "threadside",
  "displayName": "Threadside: T3 Code chat for Cursor and VS Code",
  "description": "Your own T3 Code server's chat beside your code: every thread, provider, worktree and device from T3 Code, with file links that open in the editor, selection and file chips, review in the diff view and Cursor-style shortcuts.",
  "version": "0.2.1",
  "publisher": "luisfelipesena",
  "preview": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#11141c",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/luisfelipesena/threadside.git"
  },
  "bugs": {
    "url": "https://github.com/luisfelipesena/threadside/issues"
  },
  "homepage": "https://github.com/luisfelipesena/threadside#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "t3",
    "t3 code",
    "cursor",
    "agent",
    "chat",
    "claude",
    "codex"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Threadside connects to your T3 Code server only after the workspace is trusted."
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onWebviewPanel:threadside.chat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "threadside.openChat",
        "title": "Open Chat",
        "category": "T3",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "threadside.toggleChat",
        "title": "Toggle Chat",
        "category": "T3"
      },
      {
        "command": "threadside.newThread",
        "title": "New Thread",
        "category": "T3",
        "icon": "$(add)"
      },
      {
        "command": "threadside.newThreadInTab",
        "title": "New Thread in New Tab",
        "category": "T3"
      },
      {
        "command": "threadside.searchThreads",
        "title": "Search Threads\u2026",
        "category": "T3",
        "icon": "$(search)"
      },
      {
        "command": "threadside.focusOrAddSelection",
        "title": "Chat: Focus, or Add Selection",
        "category": "T3"
      },
      {
        "command": "threadside.addSelection",
        "title": "Add Selection to T3 Chat",
        "category": "T3",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "threadside.addFile",
        "title": "Add to T3 Chat",
        "category": "T3"
      },
      {
        "command": "threadside.focusComposer",
        "title": "Focus Chat Composer",
        "category": "T3"
      },
      {
        "command": "threadside.toggleMaximize",
        "title": "Toggle Full Screen Chat",
        "category": "T3",
        "icon": "$(screen-full)"
      },
      {
        "command": "threadside.reviewChanges",
        "title": "Review Thread Changes",
        "category": "T3",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "threadside.openWorktree",
        "title": "Open Thread Worktree in New Window",
        "category": "T3",
        "icon": "$(folder-opened)"
      },
      {
        "command": "threadside.sideChat",
        "title": "Side Chat (/btw)",
        "category": "T3"
      },
      {
        "command": "threadside.stop",
        "title": "Stop Running Turn",
        "category": "T3",
        "icon": "$(debug-stop)"
      },
      {
        "command": "threadside.settle",
        "title": "Settle",
        "category": "T3",
        "icon": "$(check)"
      },
      {
        "command": "threadside.unsettle",
        "title": "Un-settle",
        "category": "T3",
        "icon": "$(history)"
      },
      {
        "command": "threadside.snooze",
        "title": "Snooze\u2026",
        "category": "T3",
        "icon": "$(bell-slash)"
      },
      {
        "command": "threadside.wake",
        "title": "Wake",
        "category": "T3",
        "icon": "$(bell)"
      },
      {
        "command": "threadside.pin",
        "title": "Pin",
        "category": "T3",
        "icon": "$(pin)"
      },
      {
        "command": "threadside.unpin",
        "title": "Unpin",
        "category": "T3",
        "icon": "$(pinned)"
      },
      {
        "command": "threadside.copyThreadLink",
        "title": "Copy Thread Link",
        "category": "T3"
      },
      {
        "command": "threadside.openSettings",
        "title": "Open T3 Settings",
        "category": "T3",
        "icon": "$(settings-gear)"
      },
      {
        "command": "threadside.openInBrowser",
        "title": "Open Thread in Browser",
        "category": "T3"
      },
      {
        "command": "threadside.refresh",
        "title": "Reconnect",
        "category": "T3",
        "icon": "$(refresh)"
      },
      {
        "command": "threadside.connect",
        "title": "Connect to T3 Code\u2026",
        "category": "T3"
      },
      {
        "command": "threadside.disconnect",
        "title": "Disconnect and Forget Credentials",
        "category": "T3"
      },
      {
        "command": "threadside.takeOverShortcuts",
        "title": "Use T3 for Cursor Chat Shortcuts",
        "category": "T3"
      },
      {
        "command": "threadside.restoreShortcuts",
        "title": "Restore Cursor Chat Shortcuts",
        "category": "T3"
      },
      {
        "command": "threadside.showLog",
        "title": "Show Log",
        "category": "T3"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "threadside.toggleMaximize",
          "when": "activeWebviewPanelId == 'threadside.chat'",
          "group": "navigation@1"
        },
        {
          "command": "threadside.reviewChanges",
          "when": "activeWebviewPanelId == 'threadside.chat' && threadside.activeHasWorktree",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "threadside.addSelection",
          "when": "editorHasSelection && threadside.connected",
          "group": "t3@1"
        }
      ],
      "explorer/context": [
        {
          "command": "threadside.addFile",
          "when": "threadside.connected && !explorerResourceIsFolder",
          "group": "t3@1"
        }
      ],
      "commandPalette": [
        {
          "command": "threadside.settle",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.snooze",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.pin",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.unpin",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.wake",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.unsettle",
          "when": "threadside.connected"
        }
      ],
      "editor/title/context": [
        {
          "command": "threadside.addFile",
          "when": "threadside.connected && resourceScheme =~ /^(file|vscode-remote)$/",
          "group": "t3@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "threadside.toggleChat",
        "key": "ctrl+cmd+l",
        "mac": "ctrl+cmd+l",
        "win": "ctrl+alt+l",
        "linux": "ctrl+alt+l"
      },
      {
        "command": "threadside.searchThreads",
        "key": "ctrl+alt+h",
        "mac": "ctrl+cmd+h",
        "when": "threadside.connected"
      },
      {
        "command": "threadside.newThread",
        "key": "ctrl+alt+n",
        "mac": "ctrl+cmd+n",
        "when": "threadside.connected"
      },
      {
        "command": "threadside.toggleMaximize",
        "key": "ctrl+alt+e",
        "mac": "ctrl+cmd+e",
        "when": "activeWebviewPanelId == 'threadside.chat'"
      },
      {
        "command": "threadside.reviewChanges",
        "key": "ctrl+alt+r",
        "mac": "ctrl+cmd+r",
        "when": "threadside.connected && threadside.activeHasWorktree"
      },
      {
        "command": "threadside.newThread",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'threadside.chat'"
      },
      {
        "command": "threadside.toggleChat",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeWebviewPanelId == 'threadside.chat'"
      }
    ],
    "configuration": {
      "title": "Threadside",
      "properties": {
        "threadside.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "T3 Code server to use, for example `https://my-mac.tailnet.ts.net`. Leave empty to use the T3 Code server on the machine where this workspace runs (found in `~/.t3/userdata/server-runtime.json`).",
          "scope": "machine"
        },
        "threadside.t3Home": {
          "type": "string",
          "default": "",
          "markdownDescription": "T3 Code data folder. Defaults to `$T3CODE_HOME` or `~/.t3`.",
          "scope": "machine"
        },
        "threadside.chatLocation": {
          "type": "string",
          "enum": [
            "beside",
            "active"
          ],
          "default": "beside",
          "enumDescriptions": [
            "Open the chat in an editor group to the right, like Cursor's chat tabs.",
            "Open the chat in the active editor group."
          ],
          "description": "Where the chat tab opens."
        },
        "threadside.openChatOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Reopen the chat beside the editor when a window starts and no chat tab was restored."
        },
        "threadside.threadScope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "default": "workspace",
          "description": "Thread search lists this workspace's projects first, or every project equally."
        },
        "threadside.openFileLinksInEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open file links from chat in this editor at the referenced line. Hold `Alt` while clicking to use T3 Code's own file preview instead."
        },
        "threadside.notifications": {
          "type": "string",
          "enum": [
            "attention",
            "all",
            "off"
          ],
          "default": "attention",
          "enumDescriptions": [
            "Notify when a thread needs an approval or an answer, fails, or hits a usage limit.",
            "Also notify when a thread finishes a turn.",
            "Never notify."
          ],
          "description": "Native notifications for threads while the chat is hidden."
        },
        "threadside.syncTheme": {
          "type": "boolean",
          "default": true,
          "description": "Follow the editor's light or dark theme in the chat."
        },
        "threadside.matchEditorColors": {
          "type": "boolean",
          "default": true,
          "description": "Use the editor theme's background, surfaces, borders and fonts in the chat, so it looks like part of the editor. Turn off to keep T3 Code's own theme."
        },
        "threadside.chatShortcuts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "mod+i": "threadside.toggleChat",
            "mod+n": "threadside.newThread",
            "mod+'": "threadside.newThread",
            "mod+shift+h": "threadside.searchThreads",
            "mod+l": "threadside.focusOrAddSelection",
            "mod+alt+e": "threadside.toggleMaximize",
            "mod+shift+p": "workbench.action.showCommands",
            "mod+p": "workbench.action.quickOpen",
            "mod+e": "workbench.action.toggleSidebarVisibility",
            "mod+j": "workbench.action.togglePanel",
            "mod+r": "workbench.action.openRecent",
            "mod+shift+e": "workbench.view.explorer",
            "mod+shift+f": "workbench.action.findInFiles",
            "mod+shift+x": "workbench.view.extensions",
            "ctrl+`": "workbench.action.terminal.toggleTerminal"
          },
          "markdownDescription": "While the chat has focus, these shortcuts run editor commands instead of going to T3 Code. Keys are written like `mod+shift+p` (`mod` is \u2318 on macOS and Ctrl elsewhere; on macOS `ctrl` is the Control key). Every other shortcut goes to T3 Code (\u2318K palette, \u2318B sidebar, \u2318F find, model and host pickers\u2026). Remove an entry to give that key back to T3 Code."
        },
        "threadside.compactChat": {
          "type": "boolean",
          "default": true,
          "description": "Open the chat with T3 Code's own thread sidebar closed when the column is narrow, so the conversation gets the room. \u2318B or full screen brings it back."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "threadside",
          "title": "T3 Chat",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "threadside": [
        {
          "id": "threadside.launcher",
          "name": "T3 Chat",
          "icon": "media/activity.svg",
          "contextualTitle": "T3 Chat"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "threadside.launcher",
        "when": "threadside.connected",
        "contents": "The chat opens beside your code.\n[Open Chat](command:threadside.openChat)\n[New Thread](command:threadside.newThread)\n[Search Threads](command:threadside.searchThreads)\n[Review Thread Changes](command:threadside.reviewChanges)\n\u2318I opens or hides the chat, \u2318L adds the selection or file, \u21e7\u2318H searches threads. Run [Use T3 for Cursor Chat Shortcuts](command:threadside.takeOverShortcuts) to use these keys."
      },
      {
        "view": "threadside.launcher",
        "when": "!threadside.connected",
        "contents": "Threadside is not connected to a T3 Code server.\n[Connect to T3 Code](command:threadside.connect)\nA server on this machine (or the remote one in an SSH window) is found on its own. For another machine, paste a pairing link from T3 Code \u2192 Settings \u2192 Sharing & access, or from `t3 pair`.\n[Show Log](command:threadside.showLog)"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "package": "npm run typecheck && npm test && npm run build -- --production && vsce package --no-dependencies",
    "contract": "node scripts/contract-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.7.0"
  }
}
