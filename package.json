{
  "name": "threadside",
  "displayName": "Threadside: T3 Code chat for Cursor and VS Code",
  "description": "Your own T3 Code server's chat beside your code: every thread, provider, worktree and device from T3 Code, with file links that open in the editor, selection and file chips, review in the diff view and Cursor-style shortcuts.",
  "version": "0.3.17",
  "publisher": "luisfelipesena",
  "preview": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#11141c",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/luisfelipesena/threadside.git"
  },
  "bugs": {
    "url": "https://github.com/luisfelipesena/threadside/issues"
  },
  "homepage": "https://github.com/luisfelipesena/threadside#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "t3",
    "t3 code",
    "cursor",
    "agent",
    "chat",
    "claude",
    "codex"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Threadside connects to your T3 Code server only after the workspace is trusted."
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "*",
    "onUri",
    "onWebviewPanel:threadside.chat",
    "onView:threadside.chatView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "threadside.openChat",
        "title": "Open Chat",
        "category": "T3",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "threadside.toggleChat",
        "title": "Toggle Chat",
        "category": "T3"
      },
      {
        "command": "threadside.newThread",
        "title": "New Thread",
        "category": "T3",
        "icon": "$(add)"
      },
      {
        "command": "threadside.newThreadInTab",
        "title": "New Thread in New Tab",
        "category": "T3"
      },
      {
        "command": "threadside.searchThreads",
        "title": "Search Threads…",
        "category": "T3",
        "icon": "$(history)"
      },
      {
        "command": "threadside.focusOrAddSelection",
        "title": "Chat: Focus, or Add Selection",
        "category": "T3"
      },
      {
        "command": "threadside.addSelection",
        "title": "Add Selection to T3 Chat",
        "category": "T3",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "threadside.addFile",
        "title": "Add to T3 Chat",
        "category": "T3"
      },
      {
        "command": "threadside.focusComposer",
        "title": "Focus Chat Composer",
        "category": "T3"
      },
      {
        "command": "threadside.toggleMaximize",
        "title": "Toggle Full Screen Chat",
        "category": "T3",
        "icon": "$(screen-full)"
      },
      {
        "command": "threadside.reviewChanges",
        "title": "Review Thread Changes",
        "category": "T3",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "threadside.openWorktree",
        "title": "Open Thread Worktree in New Window",
        "category": "T3",
        "icon": "$(folder-opened)"
      },
      {
        "command": "threadside.sideChat",
        "title": "Side Chat (/btw)",
        "category": "T3"
      },
      {
        "command": "threadside.stop",
        "title": "Stop Running Turn",
        "category": "T3",
        "icon": "$(debug-stop)"
      },
      {
        "command": "threadside.settle",
        "title": "Settle",
        "category": "T3",
        "icon": "$(check)"
      },
      {
        "command": "threadside.unsettle",
        "title": "Un-settle",
        "category": "T3",
        "icon": "$(history)"
      },
      {
        "command": "threadside.snooze",
        "title": "Snooze…",
        "category": "T3",
        "icon": "$(bell-slash)"
      },
      {
        "command": "threadside.wake",
        "title": "Wake",
        "category": "T3",
        "icon": "$(bell)"
      },
      {
        "command": "threadside.pin",
        "title": "Pin",
        "category": "T3",
        "icon": "$(pin)"
      },
      {
        "command": "threadside.unpin",
        "title": "Unpin",
        "category": "T3",
        "icon": "$(pinned)"
      },
      {
        "command": "threadside.copyThreadLink",
        "title": "Copy Thread Link",
        "category": "T3"
      },
      {
        "command": "threadside.openSettings",
        "title": "Open T3 Settings",
        "category": "T3",
        "icon": "$(settings-gear)"
      },
      {
        "command": "threadside.openInBrowser",
        "title": "Open Thread in Browser",
        "category": "T3"
      },
      {
        "command": "threadside.refresh",
        "title": "Reconnect",
        "category": "T3",
        "icon": "$(refresh)"
      },
      {
        "command": "threadside.connect",
        "title": "Connect to T3 Code…",
        "category": "T3"
      },
      {
        "command": "threadside.disconnect",
        "title": "Disconnect and Forget Credentials",
        "category": "T3"
      },
      {
        "command": "threadside.takeOverShortcuts",
        "title": "Use T3 for Cursor Chat Shortcuts",
        "category": "T3"
      },
      {
        "command": "threadside.restoreShortcuts",
        "title": "Restore Cursor Chat Shortcuts",
        "category": "T3"
      },
      {
        "command": "threadside.showLog",
        "title": "Show Log",
        "category": "T3"
      },
      {
        "command": "threadside.popOut",
        "title": "Open Thread in Editor Tab",
        "category": "T3",
        "icon": "$(link-external)"
      },
      {
        "command": "threadside.updateServer",
        "title": "Update T3 Code",
        "category": "T3"
      },
      {
        "command": "threadside.dockOnRight",
        "title": "Move Chat…",
        "category": "T3"
      },
      {
        "command": "threadside.openPickedThreadInTab",
        "title": "Open Selected Thread in New Tab",
        "category": "T3"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "threadside.toggleMaximize",
          "when": "activeWebviewPanelId == 'threadside.chat'",
          "group": "navigation@1"
        },
        {
          "command": "threadside.reviewChanges",
          "when": "activeWebviewPanelId == 'threadside.chat' && threadside.activeHasWorktree",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "threadside.addSelection",
          "when": "editorHasSelection && threadside.connected",
          "group": "t3@1"
        }
      ],
      "explorer/context": [
        {
          "command": "threadside.addFile",
          "when": "threadside.connected && !explorerResourceIsFolder",
          "group": "t3@1"
        }
      ],
      "commandPalette": [
        {
          "command": "threadside.settle",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.snooze",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.pin",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.unpin",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.wake",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.unsettle",
          "when": "threadside.connected"
        },
        {
          "command": "threadside.openPickedThreadInTab",
          "when": "false"
        }
      ],
      "editor/title/context": [
        {
          "command": "threadside.addFile",
          "when": "threadside.connected && resourceScheme =~ /^(file|vscode-remote)$/",
          "group": "t3@1"
        }
      ],
      "view/title": [
        {
          "command": "threadside.newThread",
          "when": "view == threadside.chatView",
          "group": "navigation@1"
        },
        {
          "command": "threadside.searchThreads",
          "when": "view == threadside.chatView",
          "group": "navigation@2"
        },
        {
          "command": "threadside.popOut",
          "when": "view == threadside.chatView",
          "group": "navigation@3"
        },
        {
          "command": "threadside.reviewChanges",
          "when": "view == threadside.chatView && threadside.activeHasWorktree",
          "group": "1_thread@1"
        },
        {
          "command": "threadside.sideChat",
          "when": "view == threadside.chatView",
          "group": "1_thread@2"
        },
        {
          "command": "threadside.openSettings",
          "when": "view == threadside.chatView",
          "group": "2_more@1"
        },
        {
          "command": "threadside.dockOnRight",
          "when": "view == threadside.chatView",
          "group": "2_more@2"
        },
        {
          "command": "threadside.showLog",
          "when": "view == threadside.chatView",
          "group": "2_more@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "threadside.toggleChat",
        "key": "ctrl+cmd+l",
        "mac": "ctrl+cmd+l",
        "win": "ctrl+alt+l",
        "linux": "ctrl+alt+l"
      },
      {
        "command": "threadside.searchThreads",
        "key": "ctrl+alt+h",
        "mac": "ctrl+cmd+h",
        "when": "threadside.connected"
      },
      {
        "command": "threadside.newThread",
        "key": "ctrl+alt+n",
        "mac": "ctrl+cmd+n",
        "when": "threadside.connected"
      },
      {
        "command": "threadside.toggleMaximize",
        "key": "ctrl+alt+e",
        "mac": "ctrl+cmd+e",
        "when": "activeWebviewPanelId == 'threadside.chat'"
      },
      {
        "command": "threadside.reviewChanges",
        "key": "ctrl+alt+r",
        "mac": "ctrl+cmd+r",
        "when": "threadside.connected && threadside.activeHasWorktree"
      },
      {
        "command": "threadside.newThread",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'threadside.chat'"
      },
      {
        "command": "threadside.toggleChat",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeWebviewPanelId == 'threadside.chat'"
      },
      {
        "command": "threadside.openPickedThreadInTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "threadside.threadPickerOpen"
      }
    ],
    "configuration": {
      "title": "Threadside",
      "properties": {
        "threadside.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "T3 Code server to use, for example `https://my-mac.tailnet.ts.net`. Leave empty to use the T3 Code server on the machine where this workspace runs (found in `~/.t3/userdata/server-runtime.json`).",
          "scope": "machine"
        },
        "threadside.t3Home": {
          "type": "string",
          "default": "",
          "markdownDescription": "T3 Code data folder. Defaults to `$T3CODE_HOME` or `~/.t3`.",
          "scope": "machine"
        },
        "threadside.chatLocation": {
          "type": "string",
          "enum": [
            "side",
            "beside",
            "active"
          ],
          "default": "side",
          "enumDescriptions": [
            "Dock the chat in a side bar. It moves to the Secondary Side Bar on the right on first run, like Cursor's chat, and stays wherever you move it.",
            "Open the chat as an editor tab in a group to the right of the code.",
            "Open the chat as an editor tab in the active editor group."
          ],
          "description": "Where the chat opens. Threads can also open as editor tabs (Open Thread in Editor Tab, or middle-click a thread in the list)."
        },
        "threadside.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Look for a newer T3 Code build on the server's channel (nightly or stable) every 30 minutes, show it in the status bar and offer to update the server, as T3 Code's desktop app does."
        },
        "threadside.openChatOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Show the chat when a window with a folder starts, in place of Cursor's own agent pane, which Cursor reopens on every start. The code keeps the focus. A window with no folder keeps Cursor's start page."
        },
        "threadside.createProjectForFolder": {
          "type": "boolean",
          "default": true,
          "description": "When the window's folder is a repository T3 Code does not know yet, add it as a T3 Code project so the chat starts there instead of in another project."
        },
        "threadside.threadScope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "default": "workspace",
          "description": "Thread search lists this workspace's projects first, or every project equally."
        },
        "threadside.openFileLinksInEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open file links from chat in this editor at the referenced line. Hold `Alt` while clicking to use T3 Code's own file preview instead."
        },
        "threadside.notifications": {
          "type": "string",
          "enum": [
            "attention",
            "all",
            "off"
          ],
          "default": "attention",
          "enumDescriptions": [
            "Notify when a thread needs an approval or an answer, fails, or hits a usage limit.",
            "Also notify when a thread finishes a turn.",
            "Never notify."
          ],
          "description": "Threadside's own notifications for threads while the chat is hidden. They stay quiet while T3 Code's Thread notifications (T3 Code Settings → General) are on, which show as editor notifications too."
        },
        "threadside.syncTheme": {
          "type": "boolean",
          "default": true,
          "description": "Follow the editor's light or dark theme in the chat."
        },
        "threadside.matchEditorColors": {
          "type": "boolean",
          "default": true,
          "description": "Use the editor theme's background, surfaces, borders and fonts in the chat, so it looks like part of the editor. Turn off to keep T3 Code's own theme."
        },
        "threadside.chatShortcuts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "mod+i": "threadside.toggleChat",
            "mod+n": "threadside.newThread",
            "mod+'": "threadside.newThread",
            "mod+shift+h": "threadside.searchThreads",
            "mod+l": "threadside.focusOrAddSelection",
            "mod+alt+e": "threadside.toggleMaximize",
            "mod+shift+p": "workbench.action.showCommands",
            "mod+p": "workbench.action.quickOpen",
            "mod+e": "workbench.action.toggleSidebarVisibility",
            "mod+j": "workbench.action.togglePanel",
            "mod+r": "workbench.action.openRecent",
            "mod+shift+e": "workbench.view.explorer",
            "mod+shift+f": "workbench.action.findInFiles",
            "mod+shift+x": "workbench.view.extensions",
            "ctrl+`": "workbench.action.terminal.toggleTerminal"
          },
          "markdownDescription": "While the chat has focus, these shortcuts run editor commands instead of going to T3 Code. Keys are written like `mod+shift+p` (`mod` is ⌘ on macOS and Ctrl elsewhere; on macOS `ctrl` is the Control key). Every other shortcut goes to T3 Code (⌘K palette, ⌘B sidebar, ⌘F find, model and host pickers…). Remove an entry to give that key back to T3 Code."
        },
        "threadside.sendEditorContext": {
          "type": "boolean",
          "default": true,
          "description": "Attach the editor's state to the message you send: the file in focus, the cursor or selection, the open files and the Problems the editor shows. Sent as a chip in the message, and again in a thread only after it changes."
        },
        "threadside.compactChat": {
          "type": "boolean",
          "default": true,
          "description": "Open the chat with T3 Code's own thread sidebar closed when the column is narrow, so the conversation gets the room. ⌘B or full screen brings it back."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "threadside",
          "title": "T3 Chat",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "threadside": [
        {
          "type": "webview",
          "id": "threadside.chatView",
          "name": "Chat",
          "icon": "media/activity.svg",
          "contextualTitle": "T3 Chat"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "package": "npm run typecheck && npm test && npm run build -- --production && vsce package --no-dependencies",
    "contract": "node scripts/contract-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.7.0"
  }
}
